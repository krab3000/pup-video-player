{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "sourceMap": false,
    "rootDir": "src",
    "outDir": "lib",
    // Compile against the built @krab3000/pup-wasm declarations, not its sources (which sit
    // outside this package's rootDir). pnpm -r builds pup-wasm first.
    "paths": { "@krab3000/pup-wasm": ["../pup-wasm/lib/ts/index.d.ts"] }
  },
  "include": ["src"]
}
